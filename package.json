{
  "name": "opencode-bash-classifier",
  "version": "0.5.1",
  "description": "Execution-boundary command safety classifier for OpenCode's native Bash tool: static per-segment review plus a tool-enhanced OpenAI-compatible model reviewer.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./types/index.d.ts"
    }
  },
  "files": [
    "dist/index.js",
    "src/index.ts",
    "src/config.ts",
    "src/shell-dialect.ts",
    "src/security/classifier.ts",
    "src/security/paths.ts",
    "src/security/reviewer.ts",
    "src/security/auditor.py",
    "native/windows-bash-supervisor/Cargo.toml",
    "native/windows-bash-supervisor/Cargo.lock",
    "native/windows-bash-supervisor/src/main.rs",
    "native/windows-bash-supervisor/README.md",
    "types/index.d.ts",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "bun build ./src/index.ts --outdir ./dist --target bun --format esm --external @opencode-ai/plugin",
    "build:supervisor": "cargo build --release --manifest-path ./native/windows-bash-supervisor/Cargo.toml",
    "check": "bun run build"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "bash",
    "shell",
    "security",
    "command-classifier",
    "llm-reviewer",
    "openai-compatible"
  ],
  "license": "MIT",
  "engines": {
    "opencode": ">=1.18.5"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": ">=1.18.5"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "^1.18.5",
    "@types/node": "^24.0.0",
    "typescript": "^5.8.2"
  }
}
